{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Harrow & Vale Term-Sheet Review Contract v1.0",
  "description": "Strict output contract for the term-sheet-review skill. The skill MUST return exactly this structure. No free-form prose for critical extraction. Every economic/control term is a typed field; every exception carries a severity and a citation.",
  "type": "object",
  "required": ["instrument", "company", "economics", "control", "exceptions", "missing_items", "overall_confidence"],
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "type": "string",
      "enum": ["SAFE", "priced_round", "convertible_loan_note", "seed_summary", "other"],
      "description": "Detected instrument type — the skill must handle all formats."
    },
    "company": { "type": "string" },
    "investor": { "type": ["string", "null"] },
    "date": { "type": ["string", "null"] },
    "economics": {
      "type": "object",
      "description": "Priya reviews ECONOMICS FIRST.",
      "required": ["amount", "valuation", "liquidation_preference"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": ["string", "null"], "description": "Raise / principal / purchase amount" },
        "valuation": { "type": ["string", "null"], "description": "Pre/post-money valuation or cap" },
        "valuation_basis": { "type": ["string", "null"], "enum": ["pre_money", "post_money", null] },
        "price_per_share": { "type": ["string", "null"] },
        "discount_rate": { "type": ["string", "null"] },
        "interest": { "type": ["string", "null"] },
        "option_pool": { "type": ["string", "null"] },
        "liquidation_preference": { "type": ["string", "null"], "description": "e.g. 1x non-participating" },
        "anti_dilution": { "type": ["string", "null"] },
        "pro_rata_rights": { "type": ["string", "null", "boolean"] },
        "mfn": { "type": ["string", "null", "boolean"] }
      }
    },
    "control": {
      "type": "object",
      "description": "Priya reviews CONTROL SECOND.",
      "required": ["board_composition", "protective_provisions"],
      "additionalProperties": false,
      "properties": {
        "board_composition": { "type": ["string", "null"] },
        "investor_vetoes": { "type": ["string", "null"], "description": "Protective provisions / consent rights" },
        "protective_provisions": { "type": ["string", "null"] },
        "drag_along": { "type": ["string", "null"] },
        "information_rights": { "type": ["string", "null"] },
        "exclusivity": { "type": ["string", "null"] }
      }
    },
    "exceptions": {
      "type": "array",
      "description": "The heart of the Exception Report: where the term is NON-STANDARD or AGGRESSIVE vs the BVCA-aligned baseline.",
      "items": {
        "type": "object",
        "required": ["term", "category", "severity", "finding", "confidence"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string" },
          "category": { "type": "string", "enum": ["economics", "control"] },
          "severity": { "type": "string", "enum": ["info", "watch", "aggressive"] },
          "finding": { "type": "string", "description": "Actionable, plain-English, one bullet. Not a paragraph." },
          "baseline": { "type": ["string", "null"], "description": "What the BVCA-aligned standard would be." },
          "citation": { "type": ["string", "null"], "description": "Clause / section / line the finding is drawn from." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "missing_items": {
      "type": "array",
      "description": "What is MISSING ENTIRELY vs the baseline (e.g. no pre-emptive rights).",
      "items": {
        "type": "object",
        "required": ["item", "confidence"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string" },
          "why_it_matters": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
