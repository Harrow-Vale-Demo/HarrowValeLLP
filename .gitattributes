# Line-ending policy for Harrow & Vale LLP
#
# Text files use LF in both the repository and working tree on every
# platform. This keeps editors, formatters, and coding agents aligned.
# Windows command scripts remain CRLF for compatibility with legacy
# Windows tooling.

* text=auto eol=lf

# Windows command scripts
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Text formats used in this repository
*.md         text
*.json       text
*.py         text
*.html       text
*.js         text
*.txt        text
*.yml        text
*.yaml       text
.gitignore   text
.gitattributes text

# Legacy import: extensionless HTML exports, treated as text
assets/legacy-raw-import/*  text

# Binary formats - never line-ending converted
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.pdf        binary
*.docx       binary
*.xlsx       binary
*.pptx       binary
*.zip        binary
